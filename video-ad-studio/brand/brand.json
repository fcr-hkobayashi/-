    },
    {
      "pattern": "今だけ|期間限定",
      "reason": "期間限定表示：実際に期間が定められているか確認（有利誤認）"
    },
    {
      "pattern": "最大\\s*[0-9０-９]",
      "reason": "『最大』表示：条件・適用例の明示を推奨"
    },
    {
      "pattern": "(他店|他社)(より|の)",
      "reason": "他社比較：客観的根拠が必要"
