<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hkobayashi.notion-meet-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/hayato.kobayashi/second-brain-repo/obsidian-second-brain/tools/notion_meet_sync.sh</string>
  </array>

  <!-- 20分(1200秒)おきに実行。スリープ中は動かず、復帰後にまとめて追いかける -->
