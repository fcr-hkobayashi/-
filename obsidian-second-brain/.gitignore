# 取り込み用の生データ（個人情報を含むためコミットしない）
# _import 配下は _about.md 以外すべて無視
_import/*
!_import/_about.md

# Obsidian（PC固有・自動生成のため共有しない）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.trash/

# Claude Code（ローカル権限設定）
.claude/settings.local.json

# OS/エディタの一時ファイル
.DS_Store
Thumbs.db
*.tmp
*.log

# Smart Connections のベクトルインデックス
.smart-env
